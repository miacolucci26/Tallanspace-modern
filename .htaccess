<IfModule mod_headers.c>
  # HTML (index.html, og/*, dashboards/*): el navegador siempre revalida, así el celular
  # recibe los enlaces nuevos a los .js en lugar de una copia vieja guardada.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Link previews: /inteligencia-comercial?d=mango gets an SPA shell with its
  # own Open Graph tags (same JS/CSS as index.html; the URL in the browser is unchanged).
  RewriteCond %{QUERY_STRING} (^|&)d=mango(&|$) [NC]
  RewriteRule ^inteligencia-comercial/?$ /og/inteligencia-comercial-mango.html [L]

  # Serve existing files and directories (assets, images, api/*.php) as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route — hand it to the SPA shell.
  RewriteRule ^ /index.html [L]
</IfModule>
